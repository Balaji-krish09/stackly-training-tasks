# 1. Number Sign Checker (Positive, Negative, or Zero)
# Initializing sample numbers to evaluate sign boundaries
num1 = 15

print("--- Program 1: Positive, Negative, or Zero Check ---")
if num1 > 0:
    print(f"The number {num1} is POSITIVE.")
elif num1 < 0:
    print(f"The number {num1} is NEGATIVE.")
else:
    print("The number is ZERO.")
print("\n")


# 2. Even or Odd Number Checker
# Using the mathematical modulus operator (%) to parse remainders
num2 = 42

print("--- Program 2: Even or Odd Check ---")
if num2 % 2 == 0:
    print(f"The number {num2} is EVEN.")
else:
    print(f"The number {num2} is ODD.")
print("\n")

