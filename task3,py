# 4. Largest Among Three Numbers
# Evaluating complex multi-variable states utilizing logical 'and'
n1 = 45
n2 = 89
n3 = 23

print("--- Program 4: Find Largest of Three Numbers ---")
if (n1 >= n2) and (n1 >= n3):
    largest = n1
elif (n2 >= n1) and (n2 >= n3):
    largest = n2
else:
    largest = n3

print(f"Numbers evaluated: {n1}, {n2}, {n3}")
print(f"The LARGEST number is: {largest}")
print("\n")


